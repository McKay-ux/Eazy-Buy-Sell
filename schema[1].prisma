generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         UserRole  @default(BUYER)
  country      String    @default("LS")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  addresses    Address[]

  @@index([role])
  @@map("users")
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  category    String
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("LSL")
  stock       Int           @default(1)
  country     String        @default("LS")
  imageUrls   String[]      @default([])
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sellerId])
  @@index([category, status])
  @@index([country, status])
  @@map("products")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home")
  recipient   String
  phone       String
  line1       String
  line2       String?
  town        String
  district    String?
  country     String   @default("LS")
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}
